# ==============================================================================
# Jobale Engineering PLC - Production Backend Environment Variables (.env)
# Upload/rename this file to .env inside your cPanel backend directory:
# /home/<username>/admin.jobaleengineering.com/.env
# ==============================================================================

# Security
DJANGO_SECRET_KEY=9Rnr08o44iI24yqZaGZjY-2bV0IWBXbNS50CkBqFjSrn1c-zghIkK2ynZRRzg_JGSVM
DJANGO_DEBUG=False

# Hostnames & Domains
DJANGO_ALLOWED_HOSTS=admin.jobaleengineering.com,www.admin.jobaleengineering.com,jobaleengineering.com,www.jobaleengineering.com,127.0.0.1,localhost
ALLOWED_HOSTS=admin.jobaleengineering.com,www.admin.jobaleengineering.com,jobaleengineering.com,www.jobaleengineering.com,127.0.0.1,localhost

# CORS Origins (Allows React frontend to connect)
DJANGO_CORS_ALLOWED_ORIGINS=https://jobaleengineering.com,https://www.jobaleengineering.com,http://localhost:5173
CORS_ALLOWED_ORIGINS=https://jobaleengineering.com,https://www.jobaleengineering.com,http://localhost:5173

# CSRF Trusted Origins (Allows forms, logins, and API mutations)
DJANGO_CSRF_TRUSTED_ORIGINS=https://admin.jobaleengineering.com,https://jobaleengineering.com,https://www.jobaleengineering.com
CSRF_TRUSTED_ORIGINS=https://admin.jobaleengineering.com,https://jobaleengineering.com,https://www.jobaleengineering.com

# Cookie Security (HTTPS)
DJANGO_SECURE_COOKIES=True
DJANGO_SECURE_SSL_REDIRECT=False

# Upload limits
JOBALE_MAX_UPLOAD_MB=15

# Database (Default: SQLite file db.sqlite3 in backend directory)
# If using cPanel MySQL/PostgreSQL, configure DATABASE_URL:
# DATABASE_URL=postgres://user:password@localhost:5432/dbname
