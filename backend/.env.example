# ==============================================================================
# Jobale Engineering PLC - Local Development Environment (.env)
# ==============================================================================

DJANGO_SECRET_KEY=jobale-dev-secret-key-at-least-50-characters-long-for-security
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==============================================================================
# Email & SMTP Configuration (Direct notification to civiljob12@gmail.com)
# ==============================================================================
# OPTION 1 (Recommended): Google Gmail SMTP with App Password
# 1. Enable 2-Step Verification in Google Account (myaccount.google.com/security)
# 2. Go to myaccount.google.com/apppasswords
# 3. Create a 16-character App Password (name it "Jobale Website")
# 4. Fill in the values below:
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=civiljob12@gmail.com
EMAIL_HOST_PASSWORD=YOUR_16_CHARACTER_GMAIL_APP_PASSWORD
DEFAULT_FROM_EMAIL=Jobale Engineering Website <civiljob12@gmail.com>
INQUIRY_RECIPIENT_EMAIL=civiljob12@gmail.com

# OPTION 2: cPanel Domain Webmail
# EMAIL_HOST=mail.jobaleengineering.com
# EMAIL_PORT=465
# EMAIL_USE_SSL=True
# EMAIL_USE_TLS=False
# EMAIL_HOST_USER=info@jobaleengineering.com
# EMAIL_HOST_PASSWORD=your_cpanel_email_password
# DEFAULT_FROM_EMAIL=Jobale Engineering <info@jobaleengineering.com>
# INQUIRY_RECIPIENT_EMAIL=civiljob12@gmail.com
